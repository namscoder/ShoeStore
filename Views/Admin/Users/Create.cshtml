@model ShoeStore.Models.ViewModels.UserFormViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm Tài Khoản";
}

<div class="container-fluid">

    <h2>Thêm tài khoản</h2>

    <form asp-controller="Users" asp-action="Create" method="post"
          id="userForm" autocomplete="off">

        <partial name="~/Views/Admin/Users/_UserFormFields.cshtml" model="Model" />

        <button type="submit" class="btn btn-primary">Tạo tài khoản</button>

        <a asp-controller="Users" asp-action="Index" class="btn btn-secondary ms-2">
            Hủy
        </a>
    </form>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.21.0/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/user-form.js" asp-append-version="true"></script>
}
