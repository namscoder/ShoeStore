@model ShoeStore.Models.Product
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Sửa Sản Phẩm";
}

<div class="container-fluid">

    <h2>Sửa sản phẩm</h2>

    <form asp-controller="Products" asp-action="Edit" asp-route-id="@Model.Id"
          method="post" enctype="multipart/form-data"
          id="editProductForm" autocomplete="off">

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Tên sản phẩm</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Giá (₫)</label>
            <input asp-for="Price" type="number" min="1" class="form-control no-spinner" placeholder="Ví dụ: 1500000"
                   value="@(Model.Price > 0 ? Model.Price.ToString("0") : "")" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="BrandId" class="form-label">Thương hiệu</label>
                <select asp-for="BrandId" asp-items="ViewBag.Brands" class="form-select">
                    <option value="0">-- Chọn thương hiệu --</option>
                </select>
                <span asp-validation-for="BrandId" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="CategoryId" class="form-label">Danh mục</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                    <option value="0">-- Chọn danh mục --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label for="imageFile" class="form-label">Ảnh đại diện</label>

            <div class="mb-2">
                <img id="imagePreview"
                     src="@Model.Image"
                     class="rounded border @(string.IsNullOrEmpty(Model.Image) ? "d-none" : "")"
                     style="max-width: 200px; max-height: 200px; object-fit: cover;"
                     alt="Ảnh sản phẩm" />
            </div>

            <input type="file"
                   id="imageFile"
                   name="ImageFile"
                   accept=".jpg,.jpeg,.png,.webp"
                   class="form-control"
                   data-val="true"
                   data-val-fileext="Chỉ chấp nhận ảnh .jpg, .jpeg, .png, .webp"
                   data-val-fileext-ext="jpg,jpeg,png,webp"
                   data-val-filesize="Ảnh không được vượt quá 2MB"
                   data-val-filesize-max="2097152" />
            <div class="form-text">Bỏ trống nếu muốn giữ ảnh hiện tại.</div>
            @Html.ValidationMessage("ImageFile", "", new { @class = "text-danger" })
        </div>

        @* Bảng size, màu sắc và số lượng (dùng chung với trang Thêm) *@
        <partial name="~/Views/Admin/Products/_VariantsEditor.cshtml" model="Model" />

        @* Thư viện ảnh: ảnh cũ (có thể xoá) + thêm ảnh mới, chia theo ảnh chung / từng màu *@
        <partial name="~/Views/Admin/Products/_ImageGalleryEditor.cshtml" model="Model" />

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Mô tả</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="Status" class="form-check-input" />
            <label asp-for="Status" class="form-check-label">Đang bán</label>
        </div>

        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>

        <a asp-controller="Products" asp-action="Index" class="btn btn-secondary ms-2">
            Hủy
        </a>

    </form>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.21.0/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

    @* Xử lý nút thêm/xoá dòng size, màu *@
    <script src="~/js/product-variants.js" asp-append-version="true"></script>

    @* Thư viện ảnh: xoá ảnh cũ, thêm ảnh mới theo nhóm *@
    <script src="~/js/product-images.js" asp-append-version="true"></script>

    <script>
        // ===== Luật 1: kiểm tra đuôi file =====
        $.validator.addMethod("fileext", function (value, element, allowed) {
            if (element.files.length === 0) {
                return true;
            }

            const fileName = element.files[0].name;
            const extension = fileName.split(".").pop().toLowerCase();

            return allowed.split(",").includes(extension);
        });
        $.validator.unobtrusive.adapters.addSingleVal("fileext", "ext");

        // ===== Luật 2: kiểm tra dung lượng file =====
        $.validator.addMethod("filesize", function (value, element, max) {
            if (element.files.length === 0) {
                return true;
            }

            return element.files[0].size <= Number(max);
        });
        $.validator.unobtrusive.adapters.addSingleVal("filesize", "max");

        // ===== Xem trước ảnh mới, chọn sai / bỏ chọn thì quay về ảnh cũ =====
        const preview = document.getElementById("imagePreview");
        const originalSrc = preview.getAttribute("src");

        document.getElementById("imageFile").addEventListener("change", function () {
            const file = this.files[0];
            const isValid = $(this).valid();

            if (file && isValid) {
                preview.src = URL.createObjectURL(file);
                preview.classList.remove("d-none");
            } else if (originalSrc) {
                preview.src = originalSrc;
                preview.classList.remove("d-none");
            } else {
                preview.classList.add("d-none");
            }
        });
    </script>
}