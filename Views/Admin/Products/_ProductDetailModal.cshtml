@model ShoeStore.Models.Product
@{
    var variants = Model.ProductVariants
        .OrderBy(v => v.Size?.Name)
        .ThenBy(v => v.Color?.Name)
        .ToList();
    var totalStock = variants.Sum(v => v.Quantity);

    // Thư viện ảnh chia nhóm: "Ảnh chung" trước, sau đó từng màu (theo tên màu), trong nhóm theo SortOrder
    var imageGroups = Model.Images
        .GroupBy(i => i.ColorId)
        .OrderBy(g => g.Key.HasValue)
        .ThenBy(g => g.First().Color?.Name)
        .Select(g => new
        {
            Title = g.Key.HasValue ? "Màu " + g.First().Color?.Name : "Ảnh chung",
            Images = g.OrderBy(i => i.SortOrder).ToList()
        })
        .ToList();

    // Ảnh lớn ban đầu: ảnh đại diện, nếu không có thì lấy ảnh đầu tiên trong thư viện
    var mainImage = !string.IsNullOrEmpty(Model.Image)
        ? Model.Image
        : imageGroups.SelectMany(g => g.Images).Select(i => i.ImageUrl).FirstOrDefault();

    var totalImages = (string.IsNullOrEmpty(Model.Image) ? 0 : 1) + Model.Images.Count;
    const string thumbStyle = "width: 52px; height: 52px; object-fit: cover; cursor: pointer;";
}

<div class="modal fade" id="productModal-@Model.Id" tabindex="-1"
     aria-labelledby="productModalLabel-@Model.Id" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="productModalLabel-@Model.Id">
                    Chi tiết sản phẩm #@Model.Id
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body">
                <div class="row g-4">

                    <div class="col-md-5">
                        @if (mainImage != null)
                        {
                            <img src="@mainImage" alt="@Model.Name" loading="lazy" data-role="main-image"
                                 class="rounded border w-100 mb-2 bg-light"
                                 style="height: 280px; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="border rounded p-5 text-muted text-center">Chưa có ảnh</div>
                        }

                        @* Ảnh nhỏ: bấm vào để xem lớn ở khung phía trên *@
                        @if (totalImages > 1)
                        {
                            <div class="small">
                                @if (!string.IsNullOrEmpty(Model.Image))
                                {
                                    <div class="text-muted mb-1">Ảnh đại diện</div>
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        <img src="@Model.Image" alt="Ảnh đại diện" loading="lazy"
                                             data-gallery-src="@Model.Image"
                                             class="rounded border border-2 border-primary" style="@thumbStyle" />
                                    </div>
                                }

                                @foreach (var group in imageGroups)
                                {
                                    <div class="text-muted mb-1">@group.Title (@group.Images.Count)</div>
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        @foreach (var image in group.Images)
                                        {
                                            <img src="@image.ImageUrl" alt="@group.Title" loading="lazy"
                                                 data-gallery-src="@image.ImageUrl"
                                                 class="rounded border border-2" style="@thumbStyle" />
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="col-md-7">
                        <h4 class="mb-2">@Model.Name</h4>

                        <div class="mb-3">
                            @if (Model.Status)
                            {
                                <span class="badge bg-success">Đang bán</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ẩn</span>
                            }
                        </div>

                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <th class="text-muted fw-normal" style="width: 120px;">Giá</th>
                                <td class="fw-bold text-danger">@Model.Price.ToString("N0") ₫</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Thương hiệu</th>
                                <td>@Model.Brand?.Name</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Danh mục</th>
                                <td>@Model.Category?.Name</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Tổng tồn kho</th>
                                <td>@totalStock đôi</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Số ảnh</th>
                                <td>@totalImages ảnh</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Ngày tạo</th>
                                <td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <hr />

                <h6>Mô tả</h6>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p style="white-space: pre-line;">@Model.Description</p>
                }
                else
                {
                    <p class="text-muted">Không có mô tả</p>
                }

                <h6 class="mt-3">Size, màu sắc và tồn kho</h6>
                @if (variants.Count == 0)
                {
                    <p class="text-muted">Chưa có size/màu nào</p>
                }
                else
                {
                    <table class="table table-bordered table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Size</th>
                                <th>Màu sắc</th>
                                <th>Số lượng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var variant in variants)
                            {
                                <tr>
                                    <td>@variant.Size?.Name</td>
                                    <td>@variant.Color?.Name</td>
                                    <td>
                                        @if (variant.Quantity > 0)
                                        {
                                            @variant.Quantity
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Hết hàng</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="modal-footer">
                <a asp-controller="Products" asp-action="Edit" asp-route-id="@Model.Id"
                   class="btn btn-warning">
                    Sửa sản phẩm
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>

        </div>
    </div>
</div>