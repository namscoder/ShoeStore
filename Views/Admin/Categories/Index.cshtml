@model IEnumerable<ShoeStore.Models.Category>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-controller="Categories" asp-action="Create" class="btn btn-primary">
            Thêm danh mục
        </a>
    </div>

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên danh mục</th>
                <th>Mô tả</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Id</td>

                    <td>@category.Name</td>

                    <td class="description-cell">
                        @if (!string.IsNullOrEmpty(category.Description))
                        {
                            @(category.Description.Length > 50
                                ? category.Description.Substring(0, 50) + "..."
                                : category.Description)
                        }
                        else
                        {
                            <span class="text-muted">Không có mô tả</span>
                        }
                    </td>

                    <td>
                        <a asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id"
                           class="btn btn-warning btn-sm">
                            Sửa
                        </a>

                        <form asp-controller="Categories" asp-action="Delete" asp-route-id="@category.Id" method="post"
                              class="d-inline">

                            <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này không?');">
                                Xóa
                            </button>

                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>