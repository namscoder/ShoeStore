@model ShoeStore.Models.Order
@using System.Globalization
@using ShoeStore.Models
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = $"Đơn hàng #{Model.Id}";

    var vi = new CultureInfo("vi-VN");
    string FormatPrice(decimal price) => price.ToString("N0", vi) + " ₫";

    var customerOrderCount = (int)ViewBag.CustomerOrderCount;
    var nextStatuses = OrderStatuses.NextStatuses(Model.Status);

    // Thanh tiến trình
    var steps = new[] { OrderStatuses.Pending, OrderStatuses.Confirmed, OrderStatuses.Shipping, OrderStatuses.Completed };
    var currentStep = Array.IndexOf(steps, Model.Status);
}

<div class="container-fluid">
    <a asp-controller="AdminOrders" asp-action="Index" class="text-decoration-none">
        <i class="bi bi-arrow-left"></i> Danh sách đơn hàng
    </a>

    <div class="d-flex flex-wrap align-items-center gap-3 my-3">
        <h2 class="mb-0">Đơn hàng #@Model.Id</h2>
        <span class="badge fs-6 @OrderStatuses.BadgeClass(Model.Status)">@OrderStatuses.DisplayName(Model.Status)</span>
        <span class="text-muted">Đặt lúc @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @* ===== Tiến trình ===== *@
    @if (Model.Status == OrderStatuses.Cancelled)
    {
        <div class="alert alert-secondary">Đơn hàng đã bị huỷ. Hàng trong đơn đã được trả về kho.</div>
    }
    else
    {
        <div class="card card-body mb-3">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                @for (var i = 0; i < steps.Length; i++)
                {
                    var done = i <= currentStep;
                    <span class="badge rounded-pill @(done ? OrderStatuses.BadgeClass(steps[i]) : "bg-light text-muted border") px-3 py-2">
                        @(i + 1). @OrderStatuses.DisplayName(steps[i])
                    </span>
                    @if (i < steps.Length - 1)
                    {
                        <i class="bi bi-chevron-right text-muted"></i>
                    }
                }
            </div>
        </div>
    }

    <div class="row g-3">
        @* ===== Sản phẩm ===== *@
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header fw-semibold">Sản phẩm (@Model.OrderDetails.Sum(d => d.Quantity) đôi)</div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">SL</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.OrderDetails)
                            {
                                var variant = detail.ProductVariant;
                                var product = variant?.Product;
                                var image = product?.Images
                                    .Where(i => i.ColorId == variant!.ColorId)
                                    .OrderBy(i => i.SortOrder)
                                    .Select(i => i.ImageUrl)
                                    .FirstOrDefault() ?? product?.Image;

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(image))
                                            {
                                                <img src="@image" alt="" class="rounded border"
                                                     style="width: 56px; height: 56px; object-fit: cover;" />
                                            }
                                            <div>
                                                <div class="fw-semibold">@product?.Name</div>
                                                <div class="small text-muted">
                                                    @product?.Brand?.Name · Màu: @variant?.Color?.Name · Size: @variant?.Size?.Name
                                                </div>
                                                <div class="small text-muted">Tồn kho hiện tại: @variant?.Quantity đôi</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end">@FormatPrice(detail.Price)</td>
                                    <td class="text-end">@detail.Quantity</td>
                                    <td class="text-end fw-semibold">@FormatPrice(detail.Price * detail.Quantity)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end">Phí giao hàng</td>
                                <td class="text-end text-success">Miễn phí</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Tổng cộng</td>
                                <td class="text-end fw-bold fs-5 text-danger">@FormatPrice(Model.TotalAmount)</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            @* ===== Xử lý đơn ===== *@
            <div class="card mb-3">
                <div class="card-header fw-semibold">Xử lý đơn hàng</div>
                <div class="card-body d-grid gap-2">
                    @if (!nextStatuses.Any())
                    {
                        <div class="text-muted">
                            @(Model.Status == OrderStatuses.Completed ? "Đơn đã hoàn thành." : "Đơn đã huỷ.") Không còn thao tác nào.
                        </div>
                    }

                    @foreach (var next in nextStatuses)
                    {
                        var isCancel = next == OrderStatuses.Cancelled;
                        <form asp-controller="AdminOrders" asp-action="UpdateStatus" asp-route-id="@Model.Id"
                              method="post" class="d-grid">
                            <input type="hidden" name="currentStatus" value="@Model.Status" />
                            <input type="hidden" name="newStatus" value="@next" />
                            <button type="submit" class="btn @(isCancel ? "btn-outline-danger" : "btn-primary")"
                                    onclick="return confirm('@(isCancel
                                        ? "Huỷ đơn hàng này? Hàng trong đơn sẽ được trả về kho."
                                        : $"Chuyển đơn sang \"{OrderStatuses.DisplayName(next)}\"?")');">
                                @OrderStatuses.ActionName(next)
                            </button>
                        </form>
                    }
                </div>
            </div>

            @* ===== Khách hàng + giao hàng ===== *@
            <div class="card">
                <div class="card-header fw-semibold">Khách hàng & giao hàng</div>
                <div class="card-body">
                    <dl class="mb-0">
                        <dt>Khách hàng</dt>
                        <dd>
                            @(Model.User?.FullName ?? Model.User?.Username)
                            <div class="small text-muted">
                                @@@Model.User?.Username · @Model.User?.Email
                            </div>
                            <div class="small text-muted">Đã đặt @customerOrderCount đơn</div>
                        </dd>

                        <dt>Số điện thoại nhận hàng</dt>
                        <dd><a href="tel:@Model.Phone">@Model.Phone</a></dd>

                        <dt>Địa chỉ giao hàng</dt>
                        <dd>@Model.ShippingAddress</dd>

                        <dt>Thanh toán</dt>
                        <dd class="mb-0">Khi nhận hàng (COD)</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
