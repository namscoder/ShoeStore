@{
    ViewData["Title"] = "Quên mật khẩu";

    // Email soạn sẵn tiêu đề + nội dung để khách chỉ việc điền thông tin
    var mailSubject = Uri.EscapeDataString("Yêu cầu đặt lại mật khẩu ShoeStore");
    var mailBody = Uri.EscapeDataString("Tên đăng nhập: \nSố điện thoại đã đăng ký: \nĐơn hàng gần nhất (nếu có): ");
}

<div class="auth-wrapper">
    <div class="auth-card auth-card-wide">
        <div class="auth-icon">🔑</div>
        <h1 class="auth-title">Quên mật khẩu?</h1>
        <p class="auth-subtitle">Đừng lo, cửa hàng sẽ giúp bạn lấy lại tài khoản trong vài phút.</p>

        <ol class="auth-steps">
            <li>
                <strong>Liên hệ cửa hàng</strong> qua hotline hoặc email bên dưới
                (nên gửi từ <em>chính email đã đăng ký</em>).
            </li>
            <li>
                <strong>Cung cấp</strong> tên đăng nhập và số điện thoại đã đăng ký để cửa hàng xác minh đúng là bạn.
            </li>
            <li>
                <strong>Nhận mật khẩu tạm</strong>, đăng nhập rồi vào
                <em>Tài khoản → Đổi mật khẩu</em> để đặt mật khẩu mới của riêng bạn.
            </li>
        </ol>

        <div class="auth-contact">
            <a class="btn btn-dark" href="tel:@StoreInfo.HotlineTel">📞 Gọi @StoreInfo.Hotline</a>
            <a class="btn btn-outline-dark" href="mailto:@StoreInfo.Email?subject=@mailSubject&body=@mailBody">✉️ Gửi email</a>
        </div>
        <p class="text-muted small text-center mb-0">Giờ làm việc: @StoreInfo.WorkingHours</p>

        <p class="auth-switch">
            Nhớ ra rồi?
            <a asp-controller="Account" asp-action="Login">Quay lại đăng nhập</a>
        </p>
    </div>
</div>
