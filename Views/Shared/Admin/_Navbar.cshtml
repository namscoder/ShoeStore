@{
    var displayName = User.FindFirstValue("FullName") ?? User.Identity?.Name ?? "Admin";
}

<nav class="admin-navbar">

    <div class="admin-navbar-title">

        @ViewData["Title"]

    </div>


    <div class="admin-user">

        <div class="admin-avatar">
            @(string.IsNullOrEmpty(displayName) ? "A" : displayName.Substring(0, 1).ToUpper())
        </div>

        <div>

            <strong>@displayName</strong>

            <br />

            <small class="text-muted">
                Quản trị viên
            </small>

        </div>

        <form asp-controller="Account" asp-action="Logout" method="post" class="ms-3">
            <button type="submit" class="btn btn-outline-secondary btn-sm" title="Đăng xuất">
                <i class="bi bi-box-arrow-right"></i> Đăng xuất
            </button>
        </form>

    </div>

</nav>
