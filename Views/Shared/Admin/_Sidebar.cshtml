@inject ShoeStore.Data.ApplicationDbContext Db
@using Microsoft.EntityFrameworkCore
@{
    // Số đơn đang chờ xác nhận => hiện nhắc trên menu "Đơn hàng"
    var pendingOrders = await Db.Orders.CountAsync(o => o.Status == ShoeStore.Models.OrderStatuses.Pending);
}
<aside class="admin-sidebar">

    <div class="admin-logo">
        <span>👟 ShoeStore</span>
    </div>

    <nav class="admin-menu">

        <div class="admin-menu-title">
            Tổng quan
        </div>

        <a asp-controller="Admin" asp-action="Index">

            <i class="bi bi-speedometer2"></i>

            <span>Dashboard</span>

        </a>


        <div class="admin-menu-title">
            Quản lý
        </div>

        <a asp-controller="Products" asp-action="Index">

            <i class="bi bi-box-seam"></i>

            <span>Sản phẩm</span>

        </a>

        <a class="nav-link" asp-controller="Categories" asp-action="Index">
            <i class="bi bi-tags"></i>
            <span>Danh mục</span>
        </a>

        <a class="nav-link" asp-controller="Brands" asp-action="Index">
            <i class="bi bi-shop"></i>
            <span>Thương hiệu</span>
        </a>

        <a class="nav-link" asp-controller="Colors" asp-action="Index">
            <i class="bi bi-palette"></i>
            <span>Màu sắc</span>
        </a>

        <a class="nav-link" asp-controller="AdminOrders" asp-action="Index">
            <i class="bi bi-cart3"></i>
            <span>Đơn hàng</span>
            @if (pendingOrders > 0)
            {
                <span class="badge rounded-pill bg-danger ms-auto" title="@pendingOrders đơn đang chờ xác nhận">@pendingOrders</span>
            }
        </a>

        <a class="nav-link" asp-controller="Users" asp-action="Index">
            <i class="bi bi-people"></i>
            <span>Người dùng</span>
        </a>


        <div class="admin-menu-title">
            Hệ thống
        </div>

        <a asp-controller="Profile" asp-action="Index">
            <i class="bi bi-person-gear"></i>
            <span>Tài khoản</span>
        </a>


        <a asp-controller="Home" asp-action="Index">

            <i class="bi bi-house"></i>

            <span>Về trang chủ</span>

        </a>

    </nav>

</aside>