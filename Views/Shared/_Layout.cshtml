﻿@{
    // Trang nào đặt ViewData["FullWidth"] = true sẽ không bị bó trong .container (vd: trang chủ)
    var fullWidth = ViewData["FullWidth"] as bool? == true;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShoeStore</title>
    <script type="importmap"></script>
    <partial name="Home/_Styles" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <partial name="Home/_Header" />

    @if (fullWidth)
    {
        <main role="main">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="container py-4">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <partial name="Home/_Footer" />
    <partial name="Home/_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
