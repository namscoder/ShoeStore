<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ShoeStore Admin</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @* asp-append-version: thêm ?v=... theo nội dung file => sửa CSS là trình duyệt tự tải bản mới, không dùng bản cũ đã lưu *@
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    @* Trang nào cần CSS riêng thì khai báo @section Styles { ... } *@
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    @await Html.PartialAsync("~/Views/Shared/Admin/_Sidebar.cshtml")

    <div class="admin-main">

        @await Html.PartialAsync("~/Views/Shared/Admin/_Navbar.cshtml")

        <main class="admin-content">
            @RenderBody()
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await Html.PartialAsync("~/Views/Shared/Admin/_Scripts.cshtml")

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>