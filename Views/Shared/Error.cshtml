@model ErrorViewModel
@* Trang lỗi 500 khi code bị lỗi (chỉ dùng khi chạy Production; lúc Development sẽ hiện chi tiết lỗi cho lập trình viên) *@
@{
    ViewData["Title"] = "Đã có lỗi xảy ra";
}

<div class="err-page">
    <div class="err-code">500</div>
    <div class="err-icon">⚠️</div>
    <h1>Đã có lỗi xảy ra</h1>
    <p>Hệ thống đang gặp sự cố khi xử lý yêu cầu của bạn. Vui lòng thử lại sau ít phút.</p>

    <div class="err-actions">
        <a class="hm-btn hm-btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
        <a class="hm-btn err-btn-outline" href="javascript:history.back()">Quay lại</a>
    </div>

    <p class="err-help">
        Nếu lỗi lặp lại, hãy gọi <a href="tel:@StoreInfo.HotlineTel">@StoreInfo.Hotline</a>
        @if (Model.ShowRequestId)
        {
            <br />
            <small>Mã lỗi để cửa hàng tra cứu: <code>@Model.RequestId</code></small>
        }
    </p>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}
