@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["FullWidth"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/order.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="ct-page">
    <div class="ct-head">
        <h1>Tài khoản của tôi</h1>
    </div>

    <div class="pf-layout">
        @await Component.InvokeAsync("ProfileNav", new { active = "password" })

        <div class="pf-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="ct-alert ct-alert-ok">@TempData["SuccessMessage"]</div>
            }

            <form asp-controller="Profile" asp-action="ChangePassword" method="post" class="od-card pf-password" novalidate>
                <h2>Đổi mật khẩu</h2>

                <div class="od-field">
                    <label asp-for="CurrentPassword"></label>
                    <div class="pf-password-box">
                        <input asp-for="CurrentPassword" class="od-input" autocomplete="current-password" />
                        <button type="button" data-toggle-password aria-label="Hiện mật khẩu">Hiện</button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="od-error"></span>
                </div>

                <div class="od-field">
                    <label asp-for="NewPassword"></label>
                    <div class="pf-password-box">
                        <input asp-for="NewPassword" class="od-input" autocomplete="new-password" />
                        <button type="button" data-toggle-password aria-label="Hiện mật khẩu">Hiện</button>
                    </div>
                    <span asp-validation-for="NewPassword" class="od-error"></span>
                </div>

                <div class="od-field">
                    <label asp-for="ConfirmNewPassword"></label>
                    <div class="pf-password-box">
                        <input asp-for="ConfirmNewPassword" class="od-input" autocomplete="new-password" />
                        <button type="button" data-toggle-password aria-label="Hiện mật khẩu">Hiện</button>
                    </div>
                    <span asp-validation-for="ConfirmNewPassword" class="od-error"></span>
                </div>

                <p class="pf-hint">Mật khẩu tối thiểu 6 ký tự, gồm cả chữ và số.</p>

                <div class="pf-actions">
                    <button type="submit" class="hm-btn hm-btn-primary" data-submit>Đổi mật khẩu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/profile.js" asp-append-version="true"></script>
}
