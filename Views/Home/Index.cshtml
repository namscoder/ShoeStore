@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
    ViewData["FullWidth"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

@* Mỗi khối của trang chủ nằm trong một partial riêng ở Views/Home/ *@
<partial name="Hero" model="Model" />
<partial name="Perks" />
<partial name="Categories" model="Model" />
<partial name="BestSellers" model="Model" />
<partial name="NewProducts" model="Model" />
<partial name="Brands" model="Model" />

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
