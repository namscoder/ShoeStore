@{
    ViewData["Title"] = "Trang chủ";
}

<div class="hero">
    <div class="hero-content">
        <h1>SHOE STORE</h1>
        <h2>Phong cách của bạn, đôi giày của bạn</h2>
        <p>
            Khám phá những mẫu giày mới nhất dành cho bạn.
        </p>

        <a href="#" class="btn-shop">
            Xem sản phẩm
        </a>
    </div>
</div>

<section class="products">
    <h2>Sản phẩm nổi bật</h2>

    <div class="product-list">

        <div class="product-card">
            <div class="product-image">
                👟
            </div>

            <h3>Nike Air Force 1</h3>

            <p class="price">
                1.500.000 VNĐ
            </p>

            <button>Xem chi tiết</button>
        </div>

        <div class="product-card">
            <div class="product-image">
                👟
            </div>

            <h3>Adidas Campus</h3>

            <p class="price">
                1.200.000 VNĐ
            </p>

            <button>Xem chi tiết</button>
        </div>

        <div class="product-card">
            <div class="product-image">
                👟
            </div>

            <h3>Jordan 1</h3>

            <p class="price">
                2.500.000 VNĐ
            </p>

            <button>Xem chi tiết</button>
        </div>

    </div>
</section>